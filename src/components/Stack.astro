---
import { Code, Brain, Users, Boxes } from '@lucide/astro';

const categories = [
  {
    title: 'AI Implementation',
    icon: 'boxes',
    items: ['Context Engineering', 'Modular prompting', 'SDLC Optimization', 'AI-Driven development'],
  },
  {
    title: 'Enterprise Backend',
    icon: 'code',
    items: ['.NET Core 8', 'C#', 'Web Api', 'Microservices'],
  },
  {
    title: 'Modern Web',
    icon: 'brain',
    items: ['Laravel 12', 'React 19', 'Next.js', 'Typescript'],
  },
  {
    title: 'Cloud & Ops',
    icon: 'users',
    items: ['AWS', 'Docker', 'Kubernetes', 'CI/CD'],
  },
];
---

<section id="stack" aria-labelledby="stack-heading" class="py-48 px-8 lg:px-24 relative">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-start">
      <!-- Left: Description -->
      <div class="lg:col-span-4 space-y-12 lg:sticky lg:top-48">
        <div class="space-y-4">
          <span class="mono-label text-accent-green text-xs tracking-[0.4em]">TECH_STACK_ANALYSIS</span>
          <h2 id="stack-heading" class="text-5xl text-text-primary tracking-tight uppercase">Skills Canvas</h2>
        </div>
        <p class="text-text-secondary leading-relaxed font-light text-lg">
          My technical stack is visualized as a dependency graph. I prioritize high-performance backend logic connected to modern, clinical frontend experiences.
        </p>
        <div class="space-y-6 mono-label text-[10px] uppercase tracking-widest text-accent-green/60">
          <div class="flex items-center gap-3">
            <span class="w-1 h-1 bg-accent-green"></span>
            <span>Architecture: Hexagonal / Onion</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-1 h-1 bg-accent-green"></span>
            <span>Design: Cyber-Brutalist / Modular</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-1 h-1 bg-accent-green"></span>
            <span>DevOps: CI/CD / IaC / Docker</span>
          </div>
        </div>
      </div>

      <!-- Right: Dependency Graph -->
      <div class="lg:col-span-8 bg-surface-container/20 sharp-border p-12 relative overflow-hidden min-h-[600px]">
        <div class="absolute inset-0 opacity-10 dot-grid"></div>
        <div class="relative grid grid-cols-1 md:grid-cols-2 gap-8 h-full z-10">
          <!-- Left Column -->
          <div class="flex flex-col gap-8">
            <div class="p-8 bg-dark-bg sharp-border group hover:border-accent-green/60 transition-colors" data-node="ai">
              <div class="flex justify-between items-start mb-4">
                <span class="mono-label text-accent-green text-[10px]">VER: 2.1.0</span>
                <span class="mono-data text-text-muted/30 text-[9px]">LTCY: 4ms</span>
              </div>
              <h4 class="mono-label text-lg uppercase text-text-primary mb-2 skill-node-title">AI Implementation</h4>
              <p class="mono-data text-[10px] text-text-secondary uppercase tracking-tight skill-node-desc">Context Engineering // Modular Prompting // AI-Driven SDLC</p>
            </div>
            <div class="p-8 bg-dark-bg sharp-border group hover:border-accent-green/60 transition-colors" data-node="cloud">
              <div class="flex justify-between items-start mb-4">
                <span class="mono-label text-accent-green text-[10px]">NODE_AWS</span>
                <span class="mono-data text-text-muted/30 text-[9px]">UP: 99.9%</span>
              </div>
              <h4 class="mono-label text-lg uppercase text-text-primary mb-2 skill-node-title">Cloud & DevOps</h4>
              <p class="mono-data text-[10px] text-text-secondary uppercase tracking-tight skill-node-desc">AWS (EC2/S3/RDS) // Docker // K8S // CI/CD</p>
            </div>
          </div>
          
          <!-- Right Column -->
          <div class="flex flex-col gap-8">
            <div class="p-8 bg-dark-bg sharp-border group hover:border-accent-green/60 transition-colors" data-node="web">
              <div class="flex justify-between items-start mb-4">
                <span class="mono-label text-accent-green text-[10px]">UI_CORE</span>
                <span class="mono-data text-text-muted/30 text-[9px]">TPS: 120</span>
              </div>
              <h4 class="mono-label text-lg uppercase text-text-primary mb-2 skill-node-title">Modern Web</h4>
              <p class="mono-data text-[10px] text-text-secondary uppercase tracking-tight skill-node-desc">React 19 / Next.js / Laravel 12 // TypeScript</p>
            </div>
            <div class="p-8 bg-dark-bg sharp-border group hover:border-accent-green/60 transition-colors" data-node="arch">
              <div class="flex justify-between items-start mb-4">
                <span class="mono-label text-accent-green text-[10px]">ARCH_01</span>
                <span class="mono-data text-text-muted/30 text-[9px]">SOLID: OK</span>
              </div>
              <h4 class="mono-label text-lg uppercase text-text-primary mb-2 skill-node-title">Architecture</h4>
              <p class="mono-data text-[10px] text-text-secondary uppercase tracking-tight skill-node-desc">DDD // Hexagonal // Clean Code // SOLID</p>
            </div>
          </div>
          
          <!-- Center Absolute Node -->
          <div class="md:absolute md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 z-0 w-full md:w-56 pointer-events-none">
            <div class="p-6 bg-accent-green text-black shadow-[0_0_50px_-5px_rgba(0,255,65,0.3)] text-center sharp-border pointer-events-auto">
              <h4 class="mono-label text-lg uppercase font-bold leading-none mb-2">.NET 8<br/>Laravel 12</h4>
              <p class="mono-data text-[9px] font-bold tracking-[0.3em] uppercase opacity-60">ENTERPRISE_CORE</p>
            </div>
          </div>
          
          <!-- Connection Lines SVG -->
          <svg class="hidden md:block absolute inset-0 w-full h-full pointer-events-none">
            <path d="M 250,150 L 400,300" fill="none" stroke="rgba(0, 255, 65, 0.2)" stroke-width="1"></path>
            <path d="M 250,450 L 400,300" fill="none" stroke="rgba(0, 255, 65, 0.2)" stroke-width="1"></path>
            <path d="M 550,150 L 400,300" fill="none" stroke="rgba(0, 255, 65, 0.2)" stroke-width="1"></path>
            <path d="M 550,450 L 400,300" fill="none" stroke="rgba(0, 255, 65, 0.2)" stroke-width="1"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { getTranslations, type Language } from '../i18n/translations';

  const headingEl = document.getElementById('stack-heading') as HTMLHeadingElement;
  const descriptionEl = document.querySelector('.lg\\:col-span-4 p') as HTMLParagraphElement;
  
  const skillNodes = {
    ai: {
      es: { title: 'AI Implementation', desc: 'Context Engineering // Modular Prompting // AI-Driven SDLC' },
      en: { title: 'AI Implementation', desc: 'Context Engineering // Modular Prompting // AI-Driven SDLC' }
    },
    cloud: {
      es: { title: 'Cloud & DevOps', desc: 'AWS (EC2/S3/RDS) // Docker // K8S // CI/CD' },
      en: { title: 'Cloud & DevOps', desc: 'AWS (EC2/S3/RDS) // Docker // K8S // CI/CD' }
    },
    web: {
      es: { title: 'Modern Web', desc: 'React 19 / Next.js / Laravel 12 // TypeScript' },
      en: { title: 'Modern Web', desc: 'React 19 / Next.js / Laravel 12 // TypeScript' }
    },
    arch: {
      es: { title: 'Arquitectura', desc: 'DDD // Hexagonal // Clean Code // SOLID' },
      en: { title: 'Architecture', desc: 'DDD // Hexagonal // Clean Code // SOLID' }
    }
  };
  
  function updateStackContent(lang: Language) {
    const t = getTranslations(lang);
    if (headingEl) {
      headingEl.textContent = 'Skills Canvas';
    }
    if (descriptionEl) {
      descriptionEl.textContent = lang === 'es' 
        ? 'Mi stack técnico visualizado como grafo de dependencias. Priorizo lógica backend de alto rendimiento conectada a experiencias frontend modernas y clínicas.'
        : 'My technical stack is visualized as a dependency graph. I prioritize high-performance backend logic connected to modern, clinical frontend experiences.';
    }

    // Update skill nodes
    Object.keys(skillNodes).forEach(nodeKey => {
      const node = document.querySelector(`[data-node="${nodeKey}"]`);
      if (node) {
        const titleEl = node.querySelector('.skill-node-title');
        const descEl = node.querySelector('.skill-node-desc');
        if (titleEl) titleEl.textContent = skillNodes[nodeKey][lang].title;
        if (descEl) descEl.textContent = skillNodes[nodeKey][lang].desc;
      }
    });
  }

  window.addEventListener('languageChange', (e: Event) => {
    const customEvent = e as CustomEvent<{ lang: Language }>;
    updateStackContent(customEvent.detail.lang);
  });

  const currentLang = (localStorage.getItem('lang') as Language) || 'es';
  updateStackContent(currentLang);
</script>
