---
import { Mail, Linkedin, Github } from '@lucide/astro';
---

<footer class="bg-dark-bg border-t border-accent-green/10 px-8 py-24 relative" id="contact">
  <div class="mx-auto max-w-7xl space-y-16">
    <div class="bg-surface-container-lowest/50 backdrop-blur-md sharp-border p-8 md:p-12 mono-data relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-accent-green/20 to-transparent"></div>
      <div class="flex items-center gap-3 text-accent-green mb-8">
        <span class="text-xs uppercase tracking-[0.3em] font-bold">GEMINI_CLI v2.4 // SYSTEM_BOOT_SEQUENCE</span>
      </div>
      <div class="space-y-6 text-sm">
        <div class="text-[11px] text-text-muted/40 leading-relaxed uppercase">
          [0.0012] Loading architectural kernels... OK<br/>
          [0.0245] Initializing secure communication protocol v4.0... DONE<br/>
          [0.0567] Mapping contact endpoints... SUCCESS
        </div>
        <div class="flex gap-4 pt-4">
          <span class="text-accent-green">$</span>
          <div class="flex items-center gap-1">
            <span class="text-text-primary">octavio --contact</span>
            <span class="w-2 h-5 bg-accent-green animate-pulse"></span>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8">
          <a class="group p-6 bg-dark-bg sharp-border hover:border-accent-green transition-all" href="mailto:octaviomr9810@gmail.com">
            <span class="text-[9px] text-text-muted/50 mb-3 block uppercase tracking-widest">Protocol: Email</span>
            <span class="text-accent-green text-sm">octaviomr9810@gmail.com</span>
          </a>
          <a class="group p-6 bg-dark-bg sharp-border hover:border-accent-green transition-all" href="https://linkedin.com/in/octavio-morales-dev" target="_blank" rel="noopener noreferrer">
            <span class="text-[9px] text-text-muted/50 mb-3 block uppercase tracking-widest">Endpoint: LinkedIn</span>
            <span class="text-accent-green text-sm">/in/octavio-morales-dev</span>
          </a>
          <a class="group p-6 bg-dark-bg sharp-border hover:border-accent-green transition-all" href="https://github.com/netsky2-tech" target="_blank" rel="noopener noreferrer">
            <span class="text-[9px] text-text-muted/50 mb-3 block uppercase tracking-widest">Source: GitHub</span>
            <span class="text-accent-green text-sm">/netsky2-tech</span>
          </a>
        </div>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-between items-center gap-8 border-t border-accent-green/5 pt-12">
      <div class="mono-label text-[10px] text-text-muted/30 tracking-[0.2em] uppercase">
        octavio@morales ~ // build_2024.0.1
      </div>
      <div class="flex gap-12">
        <a class="text-text-muted/40 hover:text-accent-green mono-label text-[10px] tracking-widest uppercase transition-colors" href="https://github.com/netsky2-tech" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="text-text-muted/40 hover:text-accent-green mono-label text-[10px] tracking-widest uppercase transition-colors" href="https://linkedin.com/in/octavio-morales-dev" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>

