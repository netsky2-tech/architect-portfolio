---
import { ArrowUpRight } from "@lucide/astro";
import ProjectCard from "./ProjectCard.astro";
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="py-48 px-8 lg:px-24 bg-surface-container-lowest/30 relative"
>
  <div class="mx-auto max-w-7xl">
    <!-- Section Header -->
    <div data-reveal class="mb-16">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <div class="mono-label text-accent-green text-[10px] tracking-[0.3em] uppercase mb-4">
            MODULE_EXPLORER
          </div>
          <h2
            id="projects-heading"
            class="text-4xl md:text-5xl font-light tracking-tight text-text-primary uppercase"
          >
            PROJECT TERMINALS
          </h2>
        </div>
        <div class="mono-label text-[9px] text-text-muted/40 tracking-[0.15em] uppercase">
          TOTAL_ENTRIES: 03 // FILTERS: [PROD, ACTIVE]
        </div>
      </div>
    </div>

    <!-- Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
      <ProjectCard
        title="AINativeNav: AI-Powered Geocoding"
        titleEn="AINativeNav: AI-Powered Geocoding"
        filename="GeocodingOrchestrator.tsx"
        description="Solución al sistema de direcciones por referencia de Nicaragua mediante LLMs para traducción a coordenadas geográficas. Implementación de orquestación de contexto modular para procesar lenguaje natural semántico."
        descriptionEn="Solution to Nicaragua's reference-based address system using LLMs for translation to geographic coordinates. Implementation of modular context orchestration to process semantic natural language."
        imageSrc="/images/AiNativeNav.png"
        imageAlt="AINativeNav geocoding architecture"
        stack={[
          { icon: "⚛️", name: "REACT 19" },
          { icon: "🐘", name: "POSTGRESQL" },
          { icon: "🐳", name: "DOCKER" }
        ]}
        status="ACTIVO"
        statusEn="ACTIVE"
      />
      
      <ProjectCard
        title="Hospital Monte España"
        titleEn="Hospital Monte España"
        filename="AdmissionSystem.cs"
        description="Migración integral del sistema de admisión hospitalaria hacia arquitectura moderna. Transición exitosa a .NET Core 8, eliminando cuellos de botella en SQL Server. Incremento del 25% en velocidad de procesamiento de pacientes."
        descriptionEn="Comprehensive migration of hospital admission system to modern architecture. Successful transition to .NET Core 8, eliminating SQL Server bottlenecks. 25% increase in patient processing speed."
        imageSrc="/images/HospitalMonteEspana.png"
        imageAlt="Hospital admission system architecture"
        stack={[
          { icon: "⚡", name: ".NET 8" },
          { icon: "🗄️", name: "SQL SERVER" },
          { icon: "📊", name: "EF CORE" }
        ]}
        status="PRODUCCIÓN"
        statusEn="PRODUCTION"
      />
      
      <ProjectCard
        title="SaaS Smart Agenda"
        titleEn="SaaS Smart Agenda"
        filename="OfflineFirstAgenda.php"
        description="Sistema de gestión de citas y agendas para profesionales con nichos dinámicos. Arquitectura Offline-first con DexieDB para persistencia en navegador. Sincronización con latencia cero y reducción del 40% en tiempo de desarrollo mediante AIDD."
        descriptionEn="Appointment and schedule management system for professionals with dynamic niches. Offline-first architecture with DexieDB for browser persistence. Zero-latency sync and 40% reduction in development time through AIDD."
        imageSrc="/images/SaaSSmartAgenda.png"
        imageAlt="Smart Agenda offline-first architecture"
        stack={[
          { icon: "🐘", name: "LARAVEL 12" },
          { icon: "⚛️", name: "REACT 19" },
          { icon: "💾", name: "DEXIEDB" }
        ]}
        status="ACTIVO"
        statusEn="ACTIVE"
      />
    </div>
  </div>
</section>

<script>
  import { getTranslations, type Language } from '../i18n/translations';

  const headingEl = document.getElementById('projects-heading') as HTMLHeadingElement;
  const projectCards = document.querySelectorAll('[data-title-es]');
  
  function updateProjectsContent(lang: Language) {
    const t = getTranslations(lang);
    if (headingEl) {
      headingEl.textContent = 'PROJECT TERMINALS';
    }

    // Update each project card
    projectCards.forEach(card => {
      const titleEl = card.querySelector('.project-title');
      const descEl = card.querySelector('.project-description');
      const statusEl = card.querySelector('.project-status');

      if (titleEl) {
        titleEl.textContent = lang === 'es' 
          ? card.getAttribute('data-title-es') || ''
          : card.getAttribute('data-title-en') || '';
      }
      if (descEl) {
        descEl.textContent = lang === 'es'
          ? card.getAttribute('data-desc-es') || ''
          : card.getAttribute('data-desc-en') || '';
      }
      if (statusEl) {
        statusEl.textContent = lang === 'es'
          ? card.getAttribute('data-status-es') || ''
          : card.getAttribute('data-status-en') || '';
      }
    });
  }

  window.addEventListener('languageChange', (e: Event) => {
    const customEvent = e as CustomEvent<{ lang: Language }>;
    updateProjectsContent(customEvent.detail.lang);
  });

  const currentLang = (localStorage.getItem('lang') as Language) || 'es';
  updateProjectsContent(currentLang);
</script>
