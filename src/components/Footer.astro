---
import { Hexagon, Github, Linkedin, Twitter } from '@lucide/astro';
---

<footer class="border-t border-dark-border py-12">
  <div class="mx-auto max-w-7xl px-6">
    <div data-reveal class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-text-primary">
        <Hexagon class="h-5 w-5 text-accent-green" />
        <span>THE ARCHITECT</span>
      </a>

      <!-- Links -->
      <div class="flex items-center gap-6">
        <a href="#projects" class="text-sm text-text-muted transition-colors hover:text-text-primary">Projects</a>
        <a href="#stack" class="text-sm text-text-muted transition-colors hover:text-text-primary">Stack</a>
        <a href="#philosophy" class="text-sm text-text-muted transition-colors hover:text-text-primary">Philosophy</a>
        <a href="#contact" class="text-sm text-text-muted transition-colors hover:text-text-primary">Contact</a>
      </div>

      <!-- Socials -->
      <div class="flex items-center gap-4">
        <a href="#" class="text-text-muted transition-colors hover:text-text-primary" aria-label="GitHub">
          <Github class="h-5 w-5" />
        </a>
        <a href="#" class="text-text-muted transition-colors hover:text-text-primary" aria-label="LinkedIn">
          <Linkedin class="h-5 w-5" />
        </a>
        <a href="#" class="text-text-muted transition-colors hover:text-text-primary" aria-label="Twitter">
          <Twitter class="h-5 w-5" />
        </a>
      </div>
    </div>

    <div class="mt-8 border-t border-dark-border pt-8 text-center text-xs text-text-muted">
      &copy; {new Date().getFullYear()} The Architect. All rights reserved.
    </div>
  </div>
</footer>
