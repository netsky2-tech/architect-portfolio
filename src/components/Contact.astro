---
import { Send, Github, Linkedin, Mail } from '@lucide/astro';
---

<section id="contact" aria-labelledby="contact-heading" class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-3xl">
      <div data-reveal>
        <div class="mb-3 inline-flex items-center gap-2 border border-dark-border bg-dark-card px-4 py-1.5">
          <span class="pulse-dot h-1.5 w-1.5 bg-accent-green"></span>
          <span class="mono-label text-text-secondary">Contáctame</span>
        </div>
        <h2 id="contact-heading" class="mono-display mb-4 text-3xl font-bold tracking-tight md:text-4xl">
          Construyamos Algo Juntos
        </h2>
        <p class="max-w-2xl text-base leading-relaxed text-text-secondary">
          Disponible para roles de ingeniería senior y consultoría de arquitectura de alto impacto.
        </p>
      </div>

      <div data-reveal class="mt-12 grid gap-6 sm:grid-cols-3">
        <a href="mailto:octaviomr9810@gmail.com" class="card-hover ghost-border group flex flex-col items-start gap-3 p-6">
          <Mail class="h-6 w-6 text-accent-green" />
          <div>
            <div class="mono-label mb-1 text-text-muted">--contact: EMAIL</div>
            <div class="text-sm text-text-secondary group-hover:text-text-primary transition-colors">octaviomr9810@gmail.com</div>
          </div>
        </a>
        <a href="https://linkedin.com/in/octavio-morales-dev" target="_blank" rel="noopener noreferrer" class="card-hover ghost-border group flex flex-col items-start gap-3 p-6">
          <Linkedin class="h-6 w-6 text-accent-blue" />
          <div>
            <div class="mono-label mb-1 text-text-muted">--contact: LINKEDIN</div>
            <div class="text-sm text-text-secondary group-hover:text-text-primary transition-colors">octavio-morales-dev</div>
          </div>
        </a>
        <a href="https://github.com/netsky2-tech" target="_blank" rel="noopener noreferrer" class="card-hover ghost-border group flex flex-col items-start gap-3 p-6">
          <Github class="h-6 w-6 text-accent-green" />
          <div>
            <div class="mono-label mb-1 text-text-muted">--contact: GITHUB</div>
            <div class="text-sm text-text-secondary group-hover:text-text-primary transition-colors">netsky2-tech</div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
